{
  "private": true,
  "workspaces": [
    "packages/catlas-editor",
    "packages/catlas-features",
    "packages/catlas-leaflet",
    "packages/catlas-viewer",
    "packages/domain",
    "packages/louis",
    "packages/schema"
  ],
  "type": "module",
  "scripts": {
    "dev": "pnpm --recursive --parallel run dev",
    "clean": "node scripts/clean.mjs",
    "codegen": "pnpm --recursive --parallel run codegen",
    "db:down": "docker compose down",
    "db:down:volumes": "docker compose down -v",
    "db:up": "docker compose up -d",
    "db:schema": "bash scripts/generate-diesel-schema.sh",
    "build": "tsc -b tsconfig.build.json && pnpm --recursive run build",
    "check": "tsc -b tsconfig.json",
    "check-recursive": "pnpm --recursive exec tsc -b tsconfig.json",
    "db:migrate": "cargo run -p catlas-api --bin migrate --quiet",
    "test": "vp test",
    "coverage": "vp test --coverage",
    "api:codegen": "cargo run --quiet --locked -p catlas-api --bin print-openapi | openapi-typescript --output packages/catlas-editor/src/lib/editor/catlas-api.gen.ts",
    "prepare": "vp config"
  },
  "dependencies": {
    "vite-plus": "catalog:"
  },
  "devDependencies": {
    "@effect/build-utils": "^0.7.9",
    "@effect/language-service": "0.81.0",
    "@effect/vitest": "0.29.0",
    "@types/node": "^22.19.17",
    "babel-plugin-annotate-pure-calls": "^0.5.0",
    "effect": "^3.21.1",
    "glob": "^11.1.0",
    "openapi-typescript": "^7.13.0",
    "portless": "catalog:",
    "tslib": "^2.8.1",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "vite": "catalog:",
    "vitest": "npm:@voidzero-dev/vite-plus-test@^0.1.18"
  },
  "packageManager": "pnpm@10.14.0",
  "pnpm": {
    "patchedDependencies": {}
  }
}
