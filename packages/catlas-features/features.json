{
  "$schema": "./features.schema.json",
  "schemaVersion": "1.0.0",
  "defaultLocale": "ja",
  "categories": [
    {
      "id": "portal",
      "displayName": {
        "ja": "ポータル",
        "en": "Portal"
      }
    },
    {
      "id": "building",
      "displayName": {
        "ja": "建物",
        "en": "Building"
      }
    },
    {
      "id": "facility",
      "displayName": {
        "ja": "施設",
        "en": "Facility"
      }
    },
    {
      "id": "place",
      "displayName": {
        "ja": "場所",
        "en": "Place"
      }
    }
  ],
  "features": [
    {
      "id": "portal.nether",
      "displayName": {
        "ja": "ネザーポータル",
        "en": "Nether portal"
      },
      "category": "portal",
      "appliesTo": ["node"],
      "match": {
        "tags": {
          "portal": "nether"
        }
      },
      "editor": {
        "create": {
          "kind": "node",
          "tags": {
            "portal": "nether"
          }
        },
        "snapPolicy": "half",
        "fields": [
          {
            "type": "text",
            "tag": "name",
            "label": {
              "ja": "名前",
              "en": "Name"
            }
          }
        ]
      },
      "viewer": {
        "minZoom": 4,
        "icon": "nether-portal",
        "label": {
          "tag": "name",
          "minZoom": 8,
          "collisionPriority": 80
        }
      }
    },
    {
      "id": "building.generic",
      "displayName": {
        "ja": "建物",
        "en": "Building"
      },
      "category": "building",
      "appliesTo": ["area"],
      "match": {
        "tags": {
          "building": "yes"
        }
      },
      "editor": {
        "create": {
          "kind": "area",
          "tags": {
            "building": "yes"
          }
        },
        "snapPolicy": "half",
        "fields": [
          {
            "type": "text",
            "tag": "name",
            "label": {
              "ja": "名前",
              "en": "Name"
            }
          }
        ]
      },
      "viewer": {
        "minZoom": 4,
        "label": {
          "tag": "name",
          "minZoom": 6,
          "collisionPriority": 60
        }
      }
    },
