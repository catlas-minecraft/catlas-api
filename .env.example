DATABASE_URL=postgresql://catlas:catlas@127.0.0.1:5432/catlas
TEST_DATABASE_URL=postgresql://catlas:catlas@127.0.0.1:5432/catlas_test

OTEL_ENABLED=true
OTEL_SERVICE_NAME=catlas-api-rs
OTEL_EXPORTER_OTLP_ENDPOINT=http://127.0.0.1:4318

# OIDC is enabled when all required OIDC values are configured.
# OIDC_ISSUER_URL=https://idp.example.com
# OIDC_CLIENT_ID=catlas
# OIDC_AUDIENCE=replace-with-additional-id-token-audience
# OIDC_CLIENT_SECRET=replace-me
# OIDC_REDIRECT_URI=http://127.0.0.1:3000/api/auth/callback
# OIDC_POST_LOGIN_REDIRECT_URI=http://127.0.0.1:5173/
# OIDC_SCOPES=openid profile

# Keep the arbitrary userId login available for local development only.
DEV_AUTH_ENABLED=true
COOKIE_SECURE=false
